# 실제 값은 .env 에 넣는다. .env 는 절대 커밋하지 않는다.
# 이 파일에는 항상 빈 값만 커밋할 것. 키 값을 여기에 넣지 말 것.
# 실제 키는 팀 채널 DM 등 리포 외 경로로 전달한다.

# ── LLM ──────────────────────────────────────────────────────────
ANTHROPIC_API_KEY=
# 선택. 미설정 시 backend/common/config.py 의 DEFAULT_ANTHROPIC_MODEL 사용
ANTHROPIC_MODEL=

# ── Google Maps Platform — 키 2개로 분리 발급 ─────────────────────
#   A 백엔드용 : Places + Routes API. IP 제한. 절대 노출 금지
#   B 프론트용 : Maps JavaScript API 전용. HTTP 리퍼러 제한. 브라우저에 노출됨
# 하나로 합치지 말 것 — 노출된 키로 누구나 Routes 를 무제한 호출할 수 있고
# 요금은 우리 결제 계정에서 나간다.
GOOGLE_BACKEND_API_KEY=
GOOGLE_MAPS_JS_API_KEY=

# ── ODsay (국내 대중교통) ────────────────────────────────────────
# 재투입 여부는 9/6 스모크 테스트 게이트에서 결정한다.
# 해외 전용으로 확정되면 이 줄과 backend/routing/odsay_provider.py 를 함께 정리할 것.
ODSAY_API_KEY=

# ── 기타 ─────────────────────────────────────────────────────────
# ⚠️ Google 경로 응답은 약관상 캐싱 금지. CACHE_DIR 은 ODsay 응답에만 쓴다.
CACHE_DIR=data/processed/cache
