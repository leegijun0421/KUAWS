# 실제 값은 .env 에 넣는다. .env 는 절대 커밋하지 않는다.

# Anthropic Claude API
ANTHROPIC_API_KEY=
# 선택: 미설정 시 config.py 의 기본값 사용
ANTHROPIC_MODEL=

# 경로 API — 국내는 ODsay, 해외는 Google Maps (backend/routing/provider.py 가 자동 분기)
ODSAY_API_KEY=
GOOGLE_MAPS_API_KEY=

# POI 데이터
PLACES_API_KEY=

CACHE_DIR=data/processed/cache
